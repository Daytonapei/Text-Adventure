#PLAYER VARIABLES 
dog_name = ""          # stores player name
health = 10            # player health
dragon_health = 15     # enemy health

#ITEMS
has_sword = False
has_chicken = False
has_popcorn = False
has_armor = False
drank_water = False

#TRACK WHERE PLAYER HAS BEEN 
visited_left = False
visited_right = False
visited_river = False
visited_cabin = False

skunk_experience = 4
game_over = False

#INTRO FUNCTION
def intro():
    global dog_name

    print("=== A Shar Pei's Dream ===")
    dog_name = input("What is your Shar Pei's name? ")

    print("\n" + dog_name + " eats dinner, plays for a while, and falls asleep.")
    print("You wake up somewhere unfamiliar.")
    print("It's quiet. Too quiet.")
    print("Tall trees surround you, and the air feels heavy.")
    print("A voice in the distance says, 'Find what you need before going forward.'")

#SHOW AVAILABLE OPTIONS
def show_options():
    print("\nOptions:")

    # only show options not visited yet
    if visited_left == False:
        print("- left")
    if visited_right == False:
        print("- right")
    if visited_river == False:
        print("- river")
    if visited_cabin == False:
        print("- cabin")

    print("- forward")
    print("- inventory")
    print("- help")

#SHOW INVENTORY
def show_inventory():
    print("\nInventory:")

    if has_sword:
        print("- Sword held in mouth")
    if has_chicken:
        print("- Chicken")
    if has_popcorn:
        print("- Popcorn")
    if has_armor:
        print("- Blanket Armor")
    if drank_water:
        print("- River Water Effect")

    #if player has nothing
    if not has_sword and not has_chicken and not has_popcorn and not has_armor and not drank_water:
        print("- Nothing yet")

    print("Health:", health)

#HELP MENU
def show_help():
    print("\nType one of the options shown.")
    print("Once you finish an area, that option disappears.")
    print("Try to collect useful items before going forward.")

#COMBAT SYSTEM
def dragon_fight():
    global health, dragon_health, has_chicken, has_popcorn, game_over

    print("\nThe creature steps closer.")
    print("Your Health:", health)
    print("Creature Health:", dragon_health)

    #combat
    while health > 0 and dragon_health > 0:
        print("\nCombat Options:")
        print("- attack")
        print("- eat chicken")
        print("- eat popcorn")
        print("- run")

        move = input("What do you do? ").lower()

        #attack option
        if move == "attack":
            if has_sword:
                damage = 5
                dragon_health -= damage
                print("\nYou move in and strike.")
                print("The hit lands clean.")
                print("You deal", damage, "damage.")
            else:
                damage = 1
                dragon_health -= damage
                print("\nYou go in without a weapon.")
                print("That was a mistake.")
                print("You deal", damage, "damage.")

        #heal with chicken
        elif move == "eat chicken":
            if has_chicken:
                has_chicken = False
                health += 5
                print("\nYou eat the chicken and recover 5 health.")
                print("Health:", health)
            else:
                print("\nYou do not have chicken.")

        #heal with popcorn
        elif move == "eat popcorn":
            if has_popcorn:
                has_popcorn = False
                health += 3
                print("\nYou eat the popcorn and recover 3 health.")
                print("Health:", health)
            else:
                print("\nYou do not have popcorn.")

        #run away
        elif move == "run":
            print("\nYou turn and leave.")
            print("You don't find your way back.")
            print("and never wake up.")
            print("GAME OVER.")
            game_over = True
            return

        else:
            print("\nInvalid combat choice.")
            continue

        # dragon attacks
        if dragon_health > 0:
            dragon_damage = 3

            print("\nIt lunges at you.")

            if has_armor:
                dragon_damage -= 1
                print("The blanket softens the impact.")

            if skunk_experience >= 4:
                print("It releases a strong skunk smell.")
                print("You've dealt with worse.")

            health -= dragon_damage
            print("You take", dragon_damage, "damage.")
            print("Your Health:", health)
            print("Creature Health:", dragon_health)

    #check for win/lose
    if health <= 0:
        print("\nYou can't keep going.")
        print("Everything fades.")
        print("GAME OVER.")
        game_over = True

    elif dragon_health <= 0:
        print("\nThe creature slows, then collapses.")
        print("The forest goes quiet.")
        print("\nFor a moment, you just stand there.")
        print("Then... you smell something.")
        print("Chicken.")
        print("The smell gets stronger.")
        print("Everything around you starts to fade.")
        print("\nYou open your eyes.")
        print("You're back where you fell asleep.")
        print("Next to you is a small piece of chicken.")
        print("\nYou don't remember how it got there.")
        print("But it smells real.")
        print("\nYou eat it without thinking.")
        print("YOU WIN.")
        game_over = True

#MAIN GAME LOOP
def play_game():
    global visited_left, visited_right, visited_river, visited_cabin
    global has_sword, has_chicken, has_popcorn, has_armor, drank_water
    global health, game_over


    while game_over == False:
        show_options()
        choice = input("\nWhat do you do? ").lower()

        if choice == "help":
            show_help()

        elif choice == "inventory":
            show_inventory()

        #LEFT PATH
        elif choice == "left":
            if not visited_left:
                visited_left = True
                has_sword = True
                print("\nYou walk into a clearing.")
                print("A small sword is stuck in a tree stump.")
                print("You pull it free and hold it in your mouth.")
                print("It feels balanced. Useful.")
            else:
                print("\nYou already went left.")

        #RIGHT PATH
        elif choice == "right":
            if not visited_right:
                visited_right = True
                has_popcorn = True
                has_chicken = True
                print("\nYou find a small campsite.")
                print("There is leftover food: chicken and popcorn.")
                print("You take what you can.")
            else:
                print("\nYou already went right.")

        #RIVER
        elif choice == "river":
            if not visited_river:
                visited_river = True
                drank_water = True
                health += 3
                print("\nYou reach a quiet river.")
                print("The water is clear. You drink carefully.")
                print("You feel a little better.")
                print("Health:", health)
            else:
                print("\nYou already visited the river.")

        #CABIN
        elif choice == "cabin":
            if not visited_cabin:
                visited_cabin = True
                has_armor = True
                print("\nYou find an old cabin.")
                print("Inside is a worn blanket.")
                print("You wrap it around yourself for protection.")
            else:
                print("\nYou already visited the cabin.")

        #FINAL AREA
        elif choice == "forward":
            print("\nYou move deeper into the forest.")
            print("Something shifts in the dark.")
            print("A large shape steps forward.")

            print("\nIt's a Skunk Dragon.")
            print("Its fur is matted, and the smell hits immediately.")

            print("'Turn back,' it says. 'This path isn't yours.'")

            print("\nOptions:")
            print("- fight")
            print("- run")
            print("- offer chicken")
            print("- do nothing")

            battle_choice = input("\nWhat do you do? ").lower()

            if battle_choice == "run":
                print("\nYou turn and leave.")
                print("You don't find your way back.")
                print("GAME OVER.")
                game_over = True

            elif battle_choice == "offer chicken":
                if has_chicken:
                    print("\nYou place the chicken in front of the creature.")
                    print("It lowers its head and sniffs it.")
                    print("After a long pause, it steps aside.")
                    print("\nPEACEFUL ENDING: You found another way out.")
                    print("YOU WIN.")
                    game_over = True
                else:
                    print("\nYou do not have chicken to offer.")
                    print("The creature does not move.")
                    print("GAME OVER.")
                    game_over = True

            elif battle_choice == "fight":
                dragon_fight()

            elif battle_choice == "do nothing":
                print("\nYou freeze and do nothing.")
                print("The forest goes silent.")
                print("GAME OVER.")
                game_over = True

            else:
                print("\nInvalid choice.")
                print("You hesitate too long.")
                print("GAME OVER.")
                game_over = True

        else:
            print("\nInvalid choice. Pick one of the options shown.")

#START GAME
intro()
play_game()
